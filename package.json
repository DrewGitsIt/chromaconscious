{
  "name": "chromaconscious",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "e2e": "playwright test",
    "build:cf": "node -e \"require('fs').rmSync('dist-cf',{recursive:true,force:true})\" && tsc -b && vite build --base=/chromaconscious/ --outDir dist-cf/chromaconscious --emptyOutDir",
    "dev:cf": "npm run build:cf && wrangler dev",
    "deploy": "npm run build:cf && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "apca-w3": "^0.1.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "heic2any": "^0.0.4",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.141.0"
  }
}
